# 中央氣象署 (CWA) Open Data API Key (僅於伺服器端使用，不可設定為 NEXT_PUBLIC_*)
CWA_API_KEY=your_cwa_api_key_here

# 氣象資料集代碼 (預設一週天氣預報 F-A0010-001)
CWA_DATASET_ID=F-A0010-001

# 本機開發 SQLite 資料庫連線字串
DATABASE_URL=file:weather.db

# Vercel 正式環境 Turso / libSQL 資料庫配置 (本機開發可留空)
DATABASE_AUTH_TOKEN=

# API 資料同步金鑰 (保護 /api/weather/sync 端點)
SYNC_SECRET=your_secure_sync_secret_token_here
